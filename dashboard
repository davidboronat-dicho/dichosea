<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dicho · Panel</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { height:100%; overflow:hidden; }
  iframe {
    width:100%; height:100%; border:none; display:block;
  }
  .loading-wrap {
    position:fixed; inset:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:16px; background:#F0F7F3; font-family:-apple-system,sans-serif; color:#6a9a80; font-size:14px;
  }
  .spinner {
    width:32px; height:32px; border:3px solid #C8E6D8; border-top-color:#2DB67D;
    border-radius:50%; animation:spin .8s linear infinite;
  }
  @keyframes spin { to { transform:rotate(360deg); } }
</style>
</head>
<body>

<div class="loading-wrap" id="loading">
  <div class="spinner"></div>
  <span>Cargando tu panel…</span>
</div>

<iframe id="app-frame" onload="document.getElementById('loading').style.display='none'"></iframe>

<script>
  // El destino real vive en Apps Script; aquí solo lo embebemos para que
  // el usuario vea siempre dichosea.com/dashboard en la barra de direcciones.
  var GAS_BASE = 'https://script.google.com/macros/s/AKfycbwEgnKWZYNMFUclYoY3k9ujIMzF2nvL_TXq5cDoJ3cyOEKJwWLfEjjoqbcFVcV9DEvB1w/exec';

  var params = new URLSearchParams(window.location.search);
  params.set('page', 'dashboard');

  document.getElementById('app-frame').src = GAS_BASE + '?' + params.toString();
</script>

</body>
</html>
